# Скопируй в .env и подставь свои значения.
# docker compose читает .env из корня репозитория.

DB_NAME=diploma
DB_USER=diploma
DB_PASSWORD=

JWT_SECRET=
JWT_TTL_SECONDS=86400

VOTING_STAGE_ONE_TIMEOUT_SECONDS=720
VOTING_STAGE_TWO_TIMEOUT_SECONDS=180
VOTING_TIMEOUT_CHECK_INTERVAL_MS=5000

POSTGRES_PUBLISH_PORT=5432
BACKEND_PUBLISH_PORT=8080
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# Сервис kudago-import (отдельный образ). Порт на хосте → контейнер :8081
KUDAGO_IMPORT_PUBLISH_PORT=8081
DIPLOMA_KUDAGOIMPORT_HTTPIMPORTTOKEN=dev-kudago-import-diploma-local
DIPLOMA_KUDAGOIMPORT_CENTERLAT=59.956346
DIPLOMA_KUDAGOIMPORT_CENTERLON=30.309968
DIPLOMA_KUDAGOIMPORT_RADIUSMETERS=4000
# Плановый импорт (cron по умолчанию: 1-е число 04:00 Europe/Moscow). false — только POST /internal/kudago/import
DIPLOMA_KUDAGOIMPORT_SCHEDULEDIMPORTENABLED=true
# В zsh/bash при «source .env» cron с ? и * — только в кавычках:
# DIPLOMA_KUDAGOIMPORT_SCHEDULEDIMPORTCRON="0 0 4 1 * ?"
# DIPLOMA_KUDAGOIMPORT_SCHEDULEDIMPORTZONE=Europe/Moscow
